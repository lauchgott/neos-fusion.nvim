# Example: a simple presentational component prototype
#
# Shows: prototype definition, inheritance, default properties, Eel and AFX.

prototype(Vendor.Site:Component.Teaser) < prototype(Neos.Fusion:Component) {
    title = ''
    text = ''
    link = null
    imageUri = null

    # Eel expression with a helper call
    hasLink = ${String.length(props.link) > 0}

    // Both a double slash and a hash work as a comment.
    /* Block comments too. */

    renderer = afx`
        <article class="teaser">
            <img @if.hasImage={props.imageUri} src={props.imageUri} alt={props.title} />
            <h2 class="teaser__title">{props.title}</h2>
            <p>{props.text}</p>
            <a @if.hasLink={props.hasLink} href={props.link}>Read more</a>
        </article>
    `
}
