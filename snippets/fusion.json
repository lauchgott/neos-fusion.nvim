{
  "Neos.Fusion:Component": {
    "prefix": "component",
    "description": "Prototype based on Neos.Fusion:Component with an AFX renderer",
    "body": [
      "prototype(${1:Vendor.Site}:${2:Component.Name}) < prototype(Neos.Fusion:Component) {",
      "\t${3:title} = ''",
      "",
      "\trenderer = afx`",
      "\t\t<div class=\"${4:class-name}\">",
      "\t\t\t{props.${3:title}}",
      "\t\t</div>",
      "\t`",
      "}",
      "$0"
    ]
  },
  "Content prototype": {
    "prefix": "contentcomponent",
    "description": "Content prototype based on Neos.Neos:ContentComponent",
    "body": [
      "prototype(${1:Vendor.Site}:${2:Content.Name}) < prototype(Neos.Neos:ContentComponent) {",
      "\t${3:title} = \\${q(node).property('${3:title}')}",
      "",
      "\trenderer = afx`",
      "\t\t<div class=\"${4:class-name}\">{props.${3:title}}</div>",
      "\t`",
      "}",
      "$0"
    ]
  },
  "Prototype (empty)": {
    "prefix": "prototype",
    "description": "Prototype definition",
    "body": [
      "prototype(${1:Vendor.Site}:${2:Name}) < prototype(${3:Neos.Fusion:Component}) {",
      "\t$0",
      "}"
    ]
  },
  "Extend a prototype": {
    "prefix": "extend",
    "description": "Extend an existing prototype",
    "body": [
      "prototype(${1:Neos.Neos:Page}) {",
      "\t$0",
      "}"
    ]
  },
  "AFX renderer": {
    "prefix": "renderer",
    "description": "renderer using AFX",
    "body": [
      "renderer = afx`",
      "\t$0",
      "`"
    ]
  },
  "Eel expression": {
    "prefix": "eel",
    "description": "Eel expression",
    "body": [
      "\\${${1:props.value}}"
    ]
  },
  "Neos.Fusion:Join": {
    "prefix": "join",
    "description": "Neos.Fusion:Join (formerly Array)",
    "body": [
      "${1:content} = Neos.Fusion:Join {",
      "\t${2:item} = ${3:''}",
      "}"
    ]
  },
  "Neos.Fusion:Loop": {
    "prefix": "loop",
    "description": "Neos.Fusion:Loop (formerly Collection)",
    "body": [
      "${1:items} = Neos.Fusion:Loop {",
      "\titems = \\${${2:props.items}}",
      "\titemName = '${3:item}'",
      "\titemRenderer = afx`",
      "\t\t$0",
      "\t`",
      "}"
    ]
  },
  "Neos.Fusion:Map": {
    "prefix": "map",
    "description": "Neos.Fusion:Map (formerly RawCollection)",
    "body": [
      "${1:items} = Neos.Fusion:Map {",
      "\titems = \\${${2:props.items}}",
      "\titemName = '${3:item}'",
      "\titemRenderer = \\${${3:item}}",
      "}"
    ]
  },
  "Neos.Fusion:DataStructure": {
    "prefix": "datastructure",
    "description": "Neos.Fusion:DataStructure (formerly RawArray)",
    "body": [
      "${1:data} = Neos.Fusion:DataStructure {",
      "\t${2:key} = ${3:''}",
      "}"
    ]
  },
  "Neos.Fusion:Case": {
    "prefix": "case",
    "description": "Neos.Fusion:Case with matchers",
    "body": [
      "${1:content} = Neos.Fusion:Case {",
      "\t${2:matcherName} {",
      "\t\tcondition = \\${${3:true}}",
      "\t\trenderer = ${4:''}",
      "\t}",
      "",
      "\tdefault {",
      "\t\tcondition = true",
      "\t\trenderer = ''",
      "\t}",
      "}"
    ]
  },
  "Neos.Fusion:Tag": {
    "prefix": "tag",
    "description": "Neos.Fusion:Tag",
    "body": [
      "${1:element} = Neos.Fusion:Tag {",
      "\ttagName = '${2:div}'",
      "\tattributes.class = '${3:class-name}'",
      "\tcontent = ${4:''}",
      "}"
    ]
  },
  "Neos.Fusion:Value": {
    "prefix": "value",
    "description": "Neos.Fusion:Value",
    "body": [
      "${1:name} = Neos.Fusion:Value {",
      "\tvalue = \\${${2:props.value}}",
      "}"
    ]
  },
  "Resource URI": {
    "prefix": "resource",
    "description": "Reference a static resource",
    "body": [
      "'resource://${1:Vendor.Site}/Public/${2:Images/logo.svg}'"
    ]
  },
  "@if": {
    "prefix": "@if",
    "description": "Condition",
    "body": [
      "@if.${1:condition} = \\${${2:props.value} ? true : false}"
    ]
  },
  "@process": {
    "prefix": "@process",
    "description": "Processor",
    "body": [
      "@process.${1:name} = \\${${2:value}}"
    ]
  },
  "@context": {
    "prefix": "@context",
    "description": "Set a context variable",
    "body": [
      "@context.${1:name} = \\${${2:value}}"
    ]
  },
  "@apply": {
    "prefix": "@apply",
    "description": "Apply properties",
    "body": [
      "@apply.${1:name} = \\${${2:props}}"
    ]
  },
  "Translation": {
    "prefix": "translate",
    "description": "Neos.Neos:Translation or the Translate helper",
    "body": [
      "\\${Translation.translate('${1:id}', '${2:fallback}', [], '${3:Main}', '${4:Vendor.Site}')}"
    ]
  },
  "fusion-ignore": {
    "prefix": "ignore",
    "description": "Suppress the language server diagnostic for the next line",
    "body": [
      "// @fusion-ignore"
    ]
  },
  "fusion-ignore-block": {
    "prefix": "ignoreblock",
    "description": "Suppress the language server diagnostic for the block",
    "body": [
      "// @fusion-ignore-block"
    ]
  }
}
